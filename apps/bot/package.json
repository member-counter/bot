{
  "name": "@mc/botz",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "build": "tsup-node",
    "dev": "pnpm with-env pnpm build --watch=. --watch=../../packages --ignore-watch=../../packages/*/node_modules --onSuccess \"pnpm run start\"",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env node --enable-source-maps ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "generate-i18next-res": "i18next-resources-for-ts interface -i ./src/locales/en-US -o ./src/@types/resources.d.ts",
    "postgenerate-i18next-res": "pnpm run format --write ./src/@types/resources.d.ts ./src/locales/**/*.json",
    "dev:generate-i18next-res": "pnpm run generate-i18next-res --watch",
    "codegen": "pnpm run generate-i18next-res",
    "dev:codegen": "pnpm run dev:generate-i18next-res",
    "tolgee:push": "pnpm with-env tolgee push",
    "tolgee:pull": "pnpm with-env tolgee pull",
    "posttolgee:pull": "pnpm run generate-i18next-res"
  },
  "devDependencies": {
    "@mc/eslint-config": "workspace:*",
    "@mc/prettier-config": "workspace:*",
    "@mc/tsconfig": "workspace:*",
    "@tolgee/cli": "^2.15.1",
    "@types/node": "^22.19.7",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "prettier": "@mc/prettier-config",
  "dependencies": {
    "@discordjs/builders": "^1.13.1",
    "@discordjs/rest": "^2.6.0",
    "@mc/common": "workspace:*",
    "@mc/db": "workspace:*",
    "@mc/logger": "workspace:*",
    "@mc/redis": "workspace:*",
    "@mc/services": "workspace:*",
    "@sesamecare-oss/redlock": "^1.4.0",
    "@t3-oss/env-core": "^0.13.10",
    "bufferutil": "^4.1.0",
    "cron": "^3.5.0",
    "discord-api-types": "^0.38.37",
    "discord.js": "^14.25.1",
    "i18next": "^23.16.8",
    "i18next-resources-for-ts": "^1.9.0",
    "utf-8-validate": "^6.0.6",
    "zod": "^4.3.5"
  }
}
