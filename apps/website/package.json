{
  "name": "@mc/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "make:supported-emojis": "tsx ./src/app/dashboard/servers/[guildId]/TemplateEditor/Emoji/makeSupportedEmojis.ts && prettier --write ./src/app/dashboard/servers/[guildId]/TemplateEditor/Emoji/supportedEmojis.ts",
    "make:twemoji-map": "tsx ./src/app/dashboard/servers/[guildId]/TemplateEditor/Emoji/makeTwemojiMap.ts",
    "prebuild": "turbo run make:twemoji-map",
    "build": "pnpm with-env next build --experimental-build-mode compile",
    "clean": "git clean -xdf .next .turbo node_modules",
    "predev": "pnpm run prebuild",
    "dev": "pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "generate-i18next-res": "i18next-resources-for-ts interface -i ./src/i18n/locales/en-US -o ./src/@types/resources.d.ts",
    "postgenerate-i18next-res": "pnpm run format --write ./src/@types/resources.d.ts ./src/i18n/locales/**/*.json",
    "dev:generate-i18next-res": "pnpm run generate-i18next-res --watch",
    "codegen": "pnpm run generate-i18next-res",
    "dev:codegen": "pnpm run dev:generate-i18next-res",
    "tolgee:push": "pnpm with-env tolgee push",
    "tolgee:pull": "pnpm with-env tolgee pull",
    "posttolgee:pull": "pnpm run generate-i18next-res"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@mc/common": "workspace:*",
    "@mc/db": "workspace:*",
    "@mc/logger": "workspace:*",
    "@mc/redis": "workspace:*",
    "@mc/services": "workspace:*",
    "@mc/telemetry": "workspace:*",
    "@mc/trpc-telemetry": "workspace:*",
    "@mc/ui": "workspace:*",
    "@mc/validators": "workspace:*",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.90.19",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@tsparticles/basic": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@twemoji/api": "^15.1.0",
    "@uidotdev/usehooks": "^2.4.1",
    "accept-language": "^3.0.20",
    "discord-api-types": "^0.38.37",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "ioredis": "^5.9.2",
    "iron-session": "^8.0.4",
    "is-hotkey": "^0.2.0",
    "iso-lang-codes": "^2.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.475.0",
    "next": "15.4.10",
    "next-nprogress-bar": "^2.4.7",
    "node-loader": "^2.1.0",
    "pretty-bytes": "^6.1.1",
    "prismjs": "^1.30.0",
    "react": "19.0.0",
    "react-cookie": "^7.2.2",
    "react-dom": "19.0.0",
    "react-i18next": "^15.7.4",
    "react-text-transition": "^3.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "slate": "^0.103.0",
    "slate-history": "^0.100.0",
    "slate-react": "^0.104.0",
    "superjson": "^2.2.6",
    "uuid": "^9.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@mc/eslint-config": "workspace:*",
    "@mc/prettier-config": "workspace:*",
    "@mc/tailwind-config": "workspace:*",
    "@mc/tsconfig": "workspace:*",
    "@tolgee/cli": "^2.15.1",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/is-hotkey": "^0.1.10",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.19.7",
    "@types/prismjs": "^1.26.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/uuid": "^9.0.8",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.2",
    "i18next-resources-for-ts": "^1.9.0",
    "jimp": "^1.6.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prettier": "@mc/prettier-config"
}
