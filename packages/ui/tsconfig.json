{
  "extends": "@mc/tsconfig/internal-package.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "paths": {
      "@mc/ui": ["./src"],
      "@mc/ui/*": ["./src/*"]
    }
  },
  "include": ["*.ts", "src", "../../tooling/typescript/reset.d.ts"],
  "exclude": ["node_modules"]
}
