{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "./dist/**",
        ".expo/**",
        ".output/**",
        ".vercel/output/**"
      ],
      "env": [
        "SKIP_ENV_VALIDATION",
        "SITE_URL",
        "VITE_SUPPORT_URL",
        "VITE_BOT_DOCS_URL",
        "VITE_BOT_REPO_URL",
        "VITE_TRANSLATION_PLATFORM_URL"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "persistent": true,
      "cache": false
    },
    "format": {
      "outputs": ["node_modules/.cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo"],
      "outputs": ["node_modules/.cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "tolgee:push": {
      "inputs": ["src/**/locales/en-US/*"]
    },
    "tolgee:pull": {
      "inputs": [],
      "outputs": ["src/**/locales/en-US/*"]
    },
    "codegen": {
      "cache": true
    },
    "dev:codegen": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  }
}
